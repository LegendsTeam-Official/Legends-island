{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legends Island",
  "version": "0.6.1",
  "identifier": "online.lgscode.island",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "island",
        "title": "Legends Island",
        "url": "island.html",
        "width": 760,
        "height": 480,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/*"
    ],
    "publisher": "Legends team",
    "shortDescription": "Островок для Windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGNDIwMzZDOTdDMEM5NEUKUldST3ljQ1hiQU5DN3pwbGV4dU05TlBTMloraUtBNWFNNFZBOGZSWDc5K2lnMDlBQnNqV21Ob3QK",
      "endpoints": [
        "https://island.lgscode.online/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}